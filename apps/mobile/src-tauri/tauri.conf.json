{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "СИНАПС",
  "version": "0.1.0",
  "identifier": "com.synapse.compass",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @synapse/frontend",
    "beforeBuildCommand": "npm run build --workspace @synapse/frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      { "title": "СИНАПС", "width": 430, "height": 900, "minWidth": 360, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
