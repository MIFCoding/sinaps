# Только локальное демо с синтетическими данными. Перед размещением смените учётные данные.
DATABASE_URL=postgres://synapse:synapse_local@localhost:55432/synapse
BIND_ADDR=127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost
COOKIE_SECURE=false
RUST_LOG=synapse_api=info,tower_http=info
# Создание демо-аккаунтов включается явно; при обычном запуске сервера не выполняется.
SYNAPSE_DEMO_SEED=true

# Публичный адрес веб-интерфейса для ссылок приглашения; для локального браузера можно оставить пустым.
VITE_PUBLIC_APP_URL=

# Демо-режим работает без почты и системных push. Для строгого режима заполните настройки ниже.
SYNAPSE_RUNTIME_MODE=demo
# SYNAPSE_MAIL_TRANSPORT=smtp
# SYNAPSE_SMTP_HOST=
# SYNAPSE_SMTP_PORT=587
# SYNAPSE_SMTP_TLS=starttls
# SYNAPSE_SMTP_FROM=
# SYNAPSE_SMTP_USERNAME=
# SYNAPSE_SMTP_PASSWORD=
# SYNAPSE_PUBLIC_APP_URL=https://app.example.org
